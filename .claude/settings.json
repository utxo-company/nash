{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo insta:*)",
      "Bash(cat:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
